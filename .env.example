# Vorlage: kopieren nach .env und Werte eintragen. Die .env niemals committen!

# --- Pflichtwerte -------------------------------------------------------------
# Bot-Token von @BotFather
TELEGRAM_BOT_TOKEN=
# API-Key von https://console.groq.com/keys
GROQ_API_KEY=

# --- Zugriff ------------------------------------------------------------------
# Deine numerische Telegram User-ID (per /whoami ermitteln).
# Leer = Einrichtungsmodus: nur /whoami funktioniert, keine KI-Anfragen.
ALLOWED_TELEGRAM_USER_ID=

# --- Persönlichkeit -----------------------------------------------------------
OWNER_NAME=Ali

# --- Sprachmodell (Groq) ------------------------------------------------------
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.7
GROQ_MAX_COMPLETION_TOKENS=2048
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=2

# --- Verlauf und Limits -------------------------------------------------------
# Anzahl gespeicherter Nachrichten (User + Assistent), die als Kontext mitgesendet werden.
HISTORY_MAX_MESSAGES=20
MAX_INPUT_CHARS=4000
# Lokal relativ zum Projektordner. In Docker wird immer /data/assistant.db verwendet.
DATABASE_PATH=data/assistant.db

# --- Logging ------------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR oder CRITICAL
LOG_LEVEL=INFO

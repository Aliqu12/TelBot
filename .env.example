# Vorlage: kopieren nach .env und Werte eintragen. Die .env niemals committen!

# --- Pflichtwerte -------------------------------------------------------------
# Bot-Token von @BotFather
TELEGRAM_BOT_TOKEN=
# Modell des Sprachmodells, Format je nach Anbieter, z. B. openai/gpt-oss-120b oder anthropic/claude-sonnet-4.5
# (OpenRouter: Namen siehe https://openrouter.ai/models). Muss Werkzeugaufrufe (Tool Calling) können.
LLM_MODEL=

# --- Zugriff ------------------------------------------------------------------
# Deine numerische Telegram User-ID (per /whoami ermitteln).
# Leer = Einrichtungsmodus: nur /whoami funktioniert, keine KI-Anfragen.
ALLOWED_TELEGRAM_USER_ID=

# --- Persönlichkeit -----------------------------------------------------------
OWNER_NAME=
# Textdatei mit der Persönlichkeit (Name, Biografie, Sprache, Begrüßung, Abschied). Standard: personality.md
# (neutral). Mitgeliefert: personalities/firzana.md. Eigene Dateien in personalities/ ablegen.
# PERSONALITY_FILE=personalities/firzana.md

# --- Sprachmodell -------------------------------------------------------------
# Anbieter: openrouter (Standard) oder groq. Nur der API-Key des gewählten Anbieters ist Pflicht.
LLM_PROVIDER=openrouter
# API-Key von https://openrouter.ai/keys
OPENROUTER_API_KEY=
# API-Key von https://console.groq.com/keys (nur bei LLM_PROVIDER=groq)
GROQ_API_KEY=
LLM_TEMPERATURE=0.7
# Maximale Antwortlänge in Tokens (bei Modellen mit Denkphase genügend groß wählen)
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Bilder -------------------------------------------------------------------
# Modell für Fotos. Leer = das Textmodell (LLM_MODEL) verarbeitet auch Bilder; es muss dann Bilder können.
LLM_IMAGE_MODEL=
# Größte erlaubte Bilddatei in MB (1-20). Groq nimmt eingebettete Bilder nur bis ca. 3 MB an.
IMAGE_MAX_MB=5

# --- Verlauf und Limits -------------------------------------------------------
# Anzahl gespeicherter Nachrichten (User + Assistent), die als Kontext mitgesendet werden.
HISTORY_MAX_MESSAGES=20
# Verlauf bei Bildanfragen (0 = keiner). Bilder kosten viele Tokens, daher weniger Kontext.
# Wirkt nie über HISTORY_MAX_MESSAGES hinaus.
IMAGE_HISTORY_MAX_MESSAGES=4
MAX_INPUT_CHARS=4000
# Lokal relativ zum Projektordner. In Docker wird immer /data/assistant.db verwendet.
DATABASE_PATH=data/assistant.db

# --- Statusmeldungen ----------------------------------------------------------
# Begrüßung beim Start und Abschied beim Beenden an ALLOWED_TELEGRAM_USER_ID. true oder false.
STATUS_MESSAGES_ENABLED=true
# Wie oft pro Minute diese Meldungen vom Sprachmodell formuliert werden dürfen (0 bis 60).
# Darüber hinaus (z. B. bei Neustart-Schleifen) wird ein fester Text gesendet, ohne LLM-Anfrage.
STATUS_LLM_MAX_PER_MINUTE=2

# --- Logging ------------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR oder CRITICAL
LOG_LEVEL=INFO

# --- E-Mail (optional) --------------------------------------------------------
# Leer = E-Mail-Funktionen deaktiviert. Unterstützt: yahoo
EMAIL_PROVIDER=
# Vollständige Yahoo-Adresse, z. B. name@yahoo.de
EMAIL_ADDRESS=
# Yahoo-App-Passwort (NICHT das normale Konto-Passwort), siehe README
EMAIL_APP_PASSWORD=
# Absendername im From-Header. Leer = OWNER_NAME
EMAIL_SENDER_NAME=
# Optionale Freigabeliste für Empfänger, kommagetrennt: Adressen oder ganze Domains
# Beispiel: ich@example.org,@meinefirma.de   Leer = jeder Empfänger nach Bestätigung per Schaltfläche
EMAIL_ALLOWED_RECIPIENTS=
# Gültigkeit einer Versandfreigabe in Sekunden (60-86400)
EMAIL_DRAFT_TTL_SECONDS=900
# Zeitlimit für IMAP/SMTP in Sekunden (5-300)
EMAIL_TIMEOUT_SECONDS=30
# Maximale Zeichen eines E-Mail-Textes, die an das Sprachmodell gehen (500-50000)
EMAIL_MAX_BODY_CHARS=6000

# --- Aufgaben (Todoist, optional) ---------------------------------------------
# Leer = Aufgaben-Funktionen deaktiviert. Unterstützt: todoist
TASK_PROVIDER=
# Persönlicher API-Token: Todoist > Einstellungen > Integrationen > Entwickler (siehe README)
TODOIST_API_TOKEN=
# Zeitlimit für Todoist-Anfragen in Sekunden (3-120)
TODOIST_TIMEOUT_SECONDS=15

# --- Zeitzone -----------------------------------------------------------------
# Grundlage für "heute", "morgen", Uhrzeiten und überfällige Aufgaben (IANA-Name)
TIMEZONE=Europe/Berlin
